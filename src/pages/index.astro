---
import BaseLayout from '../layouts/BaseLayout.astro';

const galleryImages = [
  { src: '/images/gallery/gold-fabric.jpg', alt: 'Simago wrapped in gold patterned fabric' },
  { src: '/images/IMG_2003.jpg', alt: 'Simago portrait with red lips' },
  { src: '/images/gallery/red-seat-leaning.jpg', alt: 'Simago leaning in red chair' },
  { src: '/images/IMG_7058.jpg', alt: 'Simago among flowers' },
  { src: '/images/gallery/red-rose.jpg', alt: 'Simago with rose and Puerto Rican flag' },
  { src: '/images/gallery/singing-bowls-live.jpg', alt: 'Simago performing with singing bowls' },
  { src: '/images/gallery/red-seat-looking.jpg', alt: 'Simago looking at camera in red chair' },
  { src: '/images/IMG_7055.jpg', alt: 'Simago seated near statue in garden' },
  { src: '/images/gallery/cactus-mirror.jpg', alt: 'Simago reflection in glass with cactus' },
  { src: '/images/gallery/red-seat-standing.jpg', alt: 'Simago standing in gold textile' },
  { src: '/images/about-portrait.jpg', alt: 'Simago portrait with headwrap and palm tree' },
  { src: '/images/gallery/sound-bath-ceremony.jpg', alt: 'Sound bath ceremony with singing bowls' },
];

// Add one entry per photoshoot. "id" must match the folder name minus "-shoot"
// (e.g. id "red-regality" expects a folder called public/images/red-regality-shoot/).
// Photos inside that folder must be named 1.jpg, 2.jpg, 3.jpg... up to "count".
const photoshoots = [
  {
    id: 'red-regality',
    name: 'Red Regality',
    photographer: 'Rohan DaCosta',
    photographerHandle: 'Play Date Photo',
    photographerUrl: 'https://www.instagram.com/playdatephoto/',
    photos: [
      '/images/red-regality-shoot/S1z2.jpg',
      '/images/red-regality-shoot/S2z2.jpg',
      '/images/red-regality-shoot/S3z.jpg',
      '/images/red-regality-shoot/S5z.jpg',
      '/images/red-regality-shoot/S5z-cweird-edit.jpg',
      '/images/red-regality-shoot/S8z.jpg',
      '/images/red-regality-shoot/S9z.jpg',
    ],
  },
];

const photoshootsWithPhotos = photoshoots;
---

<BaseLayout title="Simago — The Healer Emcee">

  <!-- Section 1: Hero -->
  <section class="relative min-h-screen flex items-center justify-center bg-bg-primary overflow-hidden" data-section="hero">
    <img src="/images/New Photos/IMG_5318.jpeg" alt="Simago standing by a lake among tall reeds" class="absolute inset-0 w-full h-full object-cover" />
    <div class="relative z-10 text-center px-6">
      <div class="inline-block px-8 py-6">
        <h1 class="font-heading font-light text-text-heading uppercase mt-16" style="font-size: clamp(2.5rem, 8vw, 5rem); letter-spacing: 0.35em; text-shadow: 0 0 12px rgba(0,0,0,0.9), 0 0 24px rgba(0,0,0,0.7), 0 2px 20px rgba(0,0,0,0.6);">
          SIMAGO
        </h1>
        <p class="font-heading font-light text-text-heading uppercase tracking-[0.25em] mt-4" style="font-size: clamp(1.4rem, 3.5vw, 2.1rem); text-shadow: 0 0 12px rgba(0,0,0,0.9), 0 0 24px rgba(0,0,0,0.7), 0 2px 16px rgba(0,0,0,0.6);">
          The Healer Emcee
        </p>
        <p class="font-body font-light text-text-primary mt-6 max-w-[500px] mx-auto text-center leading-relaxed flex flex-wrap justify-center gap-x-3 gap-y-1" style="font-size: clamp(0.95rem, 1.5vw, 1.1rem); text-shadow: 0 0 10px rgba(0,0,0,0.9), 0 0 20px rgba(0,0,0,0.7), 0 1px 12px rgba(0,0,0,0.5);">
          <span>Hip-Hop.</span>
          <span>Sound Healer.</span>
          <span>Storyteller.</span>
          <span>Mystic of God.</span>
        </p>
      </div>
    </div>
  </section>

  <!-- Section 2: Music -->
  <section class="relative py-24 md:py-32 overflow-hidden" data-section="music">
    <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
      <iframe
        src="https://www.youtube.com/embed/LABd291ZTDo?autoplay=1&mute=1&loop=1&playlist=LABd291ZTDo&controls=0&showinfo=0&modestbranding=1&rel=0&iv_load_policy=3&playsinline=1"
        class="yt-bg-iframe pointer-events-none"
        title="I Am the Moon — Simago"
        frameborder="0"
        allow="autoplay; encrypted-media"
      ></iframe>
    </div>
    <div class="absolute inset-0 bg-black/70"></div>
    <div class="relative z-10 max-w-5xl mx-auto px-6">
      <h2 class="font-heading font-light text-text-heading uppercase tracking-[0.35em] text-center" style="font-size: clamp(1.5rem, 4vw, 2.5rem);">
        Music
      </h2>
      <p class="font-body font-light text-text-primary mt-6 text-center max-w-2xl mx-auto leading-relaxed">
        <span class="text-accent-gold">Healer Hop™</span> — a genre of Simago's own making: hip-hop and jazz-inflected alternative music woven together with healing tones, singing bowl frequencies, and meditative soundscapes.
      </p>

      <div class="relative mt-14">
        <button id="music-prev" aria-label="Previous tracks" class="carousel-arrow carousel-arrow-left">‹</button>
        <button id="music-next" aria-label="Next tracks" class="carousel-arrow carousel-arrow-right">›</button>

        <div id="music-track" class="music-carousel-track">
          <div class="music-slide group block">
            <div class="relative aspect-square overflow-hidden rounded-lg border border-white/[0.08] group-hover:border-accent-gold/30 transition-colors">
              <img src="/images/New Photos/stay-cover.jpg" alt="Stay — single cover art" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
              <span class="absolute top-2 right-2 px-2 py-1 bg-bg-deep/80 border border-accent-gold/40 text-accent-gold text-[10px] uppercase tracking-[0.1em] rounded">Coming Soon</span>
            </div>
            <p class="font-heading text-text-heading uppercase text-xs tracking-[0.2em] mt-3">Stay</p>
            <p class="text-text-muted text-xs mt-1">From the album The Healer Emcee</p>
          </div>

          <a href="https://open.spotify.com/album/7gHLogvCgoiXKdbhU10nGa?si=nFTe8-w5S1608mzSlYRYuQ" target="_blank" rel="noopener noreferrer" class="music-slide group block" data-sound="chime">
            <div class="aspect-square overflow-hidden rounded-lg border border-white/[0.08] group-hover:border-accent-gold/30 transition-colors">
              <img src="/images/New Photos/the-journey-cover.jpg" alt="The Journey — single cover art" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
            </div>
            <p class="font-heading text-text-heading uppercase text-xs tracking-[0.2em] mt-3">The Journey</p>
            <p class="text-text-muted text-xs mt-1">feat. Simago — single from The Royalty Summit</p>
            <p class="text-accent-gold text-[10px] uppercase tracking-[0.15em] mt-1">Click to listen</p>
          </a>

          <a href="https://open.spotify.com/album/7gHLogvCgoiXKdbhU10nGa?si=nFTe8-w5S1608mzSlYRYuQ" target="_blank" rel="noopener noreferrer" class="music-slide group block" data-sound="chime">
            <div class="aspect-square overflow-hidden rounded-lg border border-white/[0.08] group-hover:border-accent-gold/30 transition-colors">
              <img src="/images/New Photos/royalty-summit-cover.jpg" alt="Voice of My Own — The Royalty Summit album cover" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
            </div>
            <p class="font-heading text-text-heading uppercase text-xs tracking-[0.2em] mt-3">Voice of My Own</p>
            <p class="text-text-muted text-xs mt-1">feat. Simago — single from The Royalty Summit</p>
            <p class="text-accent-gold text-[10px] uppercase tracking-[0.15em] mt-1">Click to listen</p>
          </a>

          <a href="https://www.youtube.com/watch?v=HRQqPA6liNk" target="_blank" rel="noopener noreferrer" class="music-slide group block" data-sound="chime">
            <div class="aspect-square overflow-hidden rounded-lg border border-white/[0.08] group-hover:border-accent-gold/30 transition-colors">
              <img src="https://img.youtube.com/vi/HRQqPA6liNk/hqdefault.jpg" alt="Demon in my Head — YouTube video" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
            </div>
            <p class="font-heading text-text-heading uppercase text-xs tracking-[0.2em] mt-3">Demon in my Head</p>
            <p class="text-text-muted text-xs mt-1">From the album The Healer Emcee</p>
            <p class="text-accent-gold text-[10px] uppercase tracking-[0.15em] mt-1">Click to watch</p>
          </a>

          <a href="https://youtu.be/LABd291ZTDo" target="_blank" rel="noopener noreferrer" class="music-slide group block" data-sound="chime">
            <div class="aspect-square overflow-hidden rounded-lg border border-white/[0.08] group-hover:border-accent-gold/30 transition-colors">
              <img src="https://img.youtube.com/vi/LABd291ZTDo/hqdefault.jpg" alt="I Am the Moon — YouTube video" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
            </div>
            <p class="font-heading text-text-heading uppercase text-xs tracking-[0.2em] mt-3">I Am the Moon</p>
            <p class="text-text-muted text-xs mt-1">From the album The Healer Emcee</p>
            <p class="text-accent-gold text-[10px] uppercase tracking-[0.15em] mt-1">Click to watch</p>
          </a>
        </div>
      </div>

      <div class="text-center mt-12">
        <a href="/music" class="font-heading text-accent-gold uppercase text-sm tracking-[0.15em] hover:text-accent-gold-hover transition-colors" data-sound="chime">
          Explore the full catalogue &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- Section 3: Gallery (organized by photoshoot) -->
  <section class="relative bg-bg-deep py-24 md:py-32 overflow-hidden" data-section="gallery">
    <div id="gallery-bg-carousel" class="absolute inset-0" aria-hidden="true">
      {galleryImages.slice(0, 6).map((img, i) => (
        <img src={img.src} alt="" class={`gallery-bg-slide absolute inset-0 w-full h-full object-cover ${i === 0 ? 'is-active' : ''}`} loading="lazy" />
      ))}
      <div class="absolute inset-0 bg-bg-deep/85"></div>
    </div>

    <div class="relative z-10 max-w-6xl mx-auto px-6">
      <h2 class="font-heading font-light text-text-heading uppercase tracking-[0.35em] text-center" style="font-size: clamp(1.5rem, 4vw, 2.5rem);">
        Gallery
      </h2>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-6 mt-14">
        {photoshootsWithPhotos.map(shoot => (
          <button type="button" class="photoshoot-card group text-left" data-shoot={shoot.id}>
            <div class="aspect-[3/4] overflow-hidden rounded-lg border border-white/[0.08] group-hover:border-accent-gold/30 transition-colors">
              <img src={shoot.photos[0]} alt={shoot.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
            </div>
            <p class="font-heading text-text-heading uppercase text-xs tracking-[0.2em] mt-3">{shoot.name}</p>
            <p class="text-text-muted text-xs mt-1">by {shoot.photographer}</p>
            <p class="text-accent-gold text-[10px] uppercase tracking-[0.15em] mt-1">Click to view photoshoot</p>
          </button>
        ))}
      </div>
    </div>

    <!-- Lightbox -->
    <div id="photoshoot-lightbox" class="fixed inset-0 z-[100] hidden bg-black/95 backdrop-blur-sm">
      <button id="lightbox-close" aria-label="Close" class="absolute top-6 right-6 text-white text-3xl z-10">&times;</button>
      <div class="h-full flex flex-col items-center justify-center px-6">
        <div class="relative w-full max-w-3xl">
          <img id="lightbox-image" src="" alt="" class="w-full max-h-[65vh] object-contain rounded" />
          <button id="lightbox-prev" aria-label="Previous photo" class="lightbox-arrow lightbox-arrow-left">‹</button>
          <button id="lightbox-next" aria-label="Next photo" class="lightbox-arrow lightbox-arrow-right">›</button>
        </div>
        <div id="lightbox-caption" class="text-text-muted text-sm mt-4 text-center"></div>
        <div id="lightbox-thumbs" class="flex gap-2 mt-6 max-w-3xl overflow-x-auto px-2"></div>
      </div>
    </div>

    <script type="application/json" id="photoshoot-data" set:html={JSON.stringify(photoshootsWithPhotos)}></script>
  </section>

  <!-- Section 4: Video -->
  <section class="relative min-h-[70vh] flex items-center justify-center overflow-hidden" data-section="video">
    <video autoplay muted loop playsinline class="absolute inset-0 w-full h-full object-cover" aria-hidden="true">
      <source src="/video/homepage-see-loop.mp4" type="video/mp4" />
    </video>
    <div class="absolute inset-0 bg-black/60"></div>
    <div class="relative z-10 text-center px-6 max-w-3xl">
      <h2 class="font-heading font-light text-text-heading uppercase tracking-[0.35em]" style="font-size: clamp(1.5rem, 4vw, 2.5rem);">
        Video
      </h2>
      <p class="font-body font-light text-text-primary mt-6 leading-relaxed">
        Live performance. Music videos. Sound healing. Behind the scenes.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mt-10 max-w-xl mx-auto">
        <a href="https://www.youtube.com/watch?v=HRQqPA6liNk" target="_blank" rel="noopener noreferrer" class="group block" data-sound="chime">
          <div class="aspect-video overflow-hidden rounded-lg border border-white/[0.15] group-hover:border-accent-gold/40 transition-colors">
            <img src="https://img.youtube.com/vi/HRQqPA6liNk/hqdefault.jpg" alt="Demon in my Head — YouTube video" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
          </div>
          <p class="font-heading text-text-heading uppercase text-xs tracking-[0.2em] mt-3">Demon in my Head</p>
          <p class="text-accent-gold text-[10px] uppercase tracking-[0.15em] mt-1">Click to watch</p>
        </a>

        <a href="https://youtu.be/LABd291ZTDo" target="_blank" rel="noopener noreferrer" class="group block" data-sound="chime">
          <div class="aspect-video overflow-hidden rounded-lg border border-white/[0.15] group-hover:border-accent-gold/40 transition-colors">
            <img src="https://img.youtube.com/vi/LABd291ZTDo/hqdefault.jpg" alt="I Am the Moon — YouTube video" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
          </div>
          <p class="font-heading text-text-heading uppercase text-xs tracking-[0.2em] mt-3">I Am the Moon</p>
          <p class="text-accent-gold text-[10px] uppercase tracking-[0.15em] mt-1">Click to watch</p>
        </a>
      </div>

      <a href="/video" class="inline-block mt-10 font-heading text-accent-gold uppercase text-sm tracking-[0.15em] hover:text-accent-gold-hover transition-colors" data-sound="chime">
        See all videos &rarr;
      </a>
    </div>
  </section>

  <!-- Section 5: Theatre -->
  <section class="bg-bg-primary py-24 md:py-32" data-section="theatre">
    <div class="max-w-5xl mx-auto px-6">
      <h2 class="font-heading font-light text-text-heading uppercase tracking-[0.35em] text-center" style="font-size: clamp(1.5rem, 4vw, 2.5rem);">
        Theatre
      </h2>
      <p class="font-body font-light text-text-primary mt-6 text-center max-w-2xl mx-auto leading-relaxed">
        Original works directed for the stage.<br />
        Theater rooted in community, cultural identity, and lived experience.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mt-14">
        <a href="/theatre" class="group block">
          <div class="aspect-[3/4] overflow-hidden rounded-lg">
            <img src="/images/theatre/stars-belong.webp" alt="The Stars Belong to All of Us" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
          </div>
          <p class="font-heading text-text-heading uppercase text-xs tracking-[0.15em] mt-3">The Stars Belong to All of Us</p>
        </a>
        <a href="/theatre" class="group block">
          <div class="aspect-[3/4] overflow-hidden rounded-lg">
            <img src="/images/theatre/florecer.jpeg" alt="Florecer — To Bloom" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
          </div>
          <p class="font-heading text-text-heading uppercase text-xs tracking-[0.15em] mt-3">Florecer — To Bloom</p>
        </a>
        <a href="/theatre" class="group block">
          <div class="aspect-[3/4] overflow-hidden rounded-lg">
            <img src="/images/theatre/achievement-gap.webp" alt="Caught in the Achievement Gap" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
          </div>
          <p class="font-heading text-text-heading uppercase text-xs tracking-[0.15em] mt-3">Caught in the Achievement Gap</p>
        </a>
      </div>

      <div class="text-center mt-12">
        <a href="/theatre" class="font-heading text-accent-gold uppercase text-sm tracking-[0.15em] hover:text-accent-gold-hover transition-colors" data-sound="chime">
          View directed works &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- Section 6: About -->
  <section class="bg-bg-deep py-24 md:py-32" data-section="about">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="aspect-[3/4] overflow-hidden rounded-lg">
          <img src="/images/IMG_2003.jpg" alt="Simago portrait" class="w-full h-full object-cover" loading="lazy" />
        </div>
        <div>
          <h2 class="font-heading font-light text-text-heading uppercase tracking-[0.35em]" style="font-size: clamp(1.5rem, 4vw, 2.5rem);">
            About
          </h2>
          <p class="font-body font-light text-text-primary mt-6 leading-relaxed">
            Sierra "Simago" Gonzalez is a Puerto Rican Cuban artist —
            Chicago born, California raised, first-generation American.
            Musician, playwright, sound healer, educator, poet.
          </p>
          <a href="/about" class="inline-block mt-8 font-heading text-accent-gold uppercase text-sm tracking-[0.15em] hover:text-accent-gold-hover transition-colors" data-sound="chime">
            Read more &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 7: Hire -->
  <section class="bg-bg-primary py-24 md:py-32" data-section="hire">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="order-2 md:order-1">
          <h2 class="font-heading font-light text-text-heading uppercase tracking-[0.35em]" style="font-size: clamp(1.5rem, 4vw, 2.5rem);">
            Hire
          </h2>
          <p class="font-body font-light text-text-primary mt-6 leading-relaxed">
            Available for performances, commissions, sound healing sessions,
            directing, workshops, and curriculum development.
            Bilingual (English/Spanish).
          </p>
          <a href="/hire" class="inline-block mt-8 font-heading text-accent-gold uppercase text-sm tracking-[0.15em] hover:text-accent-gold-hover transition-colors" data-sound="chime">
            Work with me &rarr;
          </a>
        </div>
        <div class="order-1 md:order-2 aspect-[3/4] overflow-hidden rounded-lg">
          <img src="/images/IMG_7058.jpg" alt="Simago among flowers and greenery" class="w-full h-full object-cover" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- Section 8: Contact -->
  <section class="relative py-24 md:py-32 bg-cover bg-center" style="background-image: url('/images/IMG_1998_wide.jpg');" data-section="contact">
    <div class="absolute inset-0 bg-black/65"></div>
    <div class="relative z-10 max-w-2xl mx-auto text-center px-6">
      <h2 class="font-heading font-light text-text-heading uppercase tracking-[0.35em]" style="font-size: clamp(1.5rem, 4vw, 2.5rem);">
        Contact
      </h2>
      <p class="font-body font-light text-text-primary mt-6 leading-relaxed">
        For bookings, collaborations, press inquiries, or just to say hello.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mt-10">
        <a href="mailto:simagomusic@gmail.com" class="btn-gold px-8 py-3 bg-accent-gold text-bg-deep uppercase text-sm tracking-[0.15em] font-heading hover:bg-accent-gold-hover transition-colors">Email</a>
        <a href="/contact" class="px-8 py-3 border border-accent-gold text-text-heading uppercase text-sm tracking-[0.15em] font-heading hover:bg-accent-gold hover:text-bg-deep transition-all" data-sound="chime">Contact Form</a>
      </div>
      <div class="mt-16 space-y-2">
        <p class="text-text-muted text-sm tracking-[0.1em]">Oakland, CA</p>
        <a href="https://instagram.com/simago" target="_blank" rel="noopener noreferrer" class="text-text-muted text-sm tracking-[0.1em] hover:text-accent-gold transition-colors inline-block">@simago</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .hero-slide {
    opacity: 0;
    transition: opacity 1.5s ease-in-out;
    object-position: center 15%;
  }
  .hero-slide.is-active {
    opacity: 1;
  }

  .yt-bg-iframe {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 300%;
    height: 300%;
    transform: translate(-50%, -50%);
  }

  /* Music carousel */
  .music-carousel-track {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .music-carousel-track::-webkit-scrollbar {
    display: none;
  }
  .music-slide {
    flex: 0 0 calc((100% - 3rem) / 3);
    scroll-snap-align: start;
    min-width: 160px;
  }
  @media (max-width: 768px) {
    .music-slide {
      flex-basis: calc((100% - 1.5rem) / 2);
    }
  }
  @media (max-width: 480px) {
    .music-slide {
      flex-basis: 85%;
    }
  }
  .carousel-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 9999px;
    background: rgba(0, 0, 0, 0.5);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.15);
    transition: background 0.2s;
  }
  .carousel-arrow:hover {
    background: rgba(0, 0, 0, 0.75);
  }
  .carousel-arrow-left {
    left: -0.5rem;
  }
  .carousel-arrow-right {
    right: -0.5rem;
  }
  @media (max-width: 640px) {
    .carousel-arrow {
      display: none;
    }
  }

  /* Gallery background crossfade */
  .gallery-bg-slide {
    opacity: 0;
    transition: opacity 2s ease-in-out;
  }
  .gallery-bg-slide.is-active {
    opacity: 1;
  }

  /* Photoshoot lightbox */
  .lightbox-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(0, 0, 0, 0.5);
    color: #fff;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 9999px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }
  .lightbox-arrow-left {
    left: -1rem;
  }
  .lightbox-arrow-right {
    right: -1rem;
  }
</style>

<script>
  function initHeroCarousel() {
    const container = document.getElementById('hero-carousel');
    if (!container) return;
    const slides = container.querySelectorAll('.hero-slide');
    if (slides.length <= 1) return;
    let current = 0;
    const HOLD_TIME_MS = 5000;
    setInterval(() => {
      slides[current].classList.remove('is-active');
      current = (current + 1) % slides.length;
      slides[current].classList.add('is-active');
    }, HOLD_TIME_MS);
  }

  function initMusicCarousel() {
    const track = document.getElementById('music-track');
    const prev = document.getElementById('music-prev');
    const next = document.getElementById('music-next');
    if (!track) return;
    const scrollAmount = () => (track.querySelector('.music-slide')?.clientWidth || 200) + 24;
    prev?.addEventListener('click', () => track.scrollBy({ left: -scrollAmount(), behavior: 'smooth' }));
    next?.addEventListener('click', () => track.scrollBy({ left: scrollAmount(), behavior: 'smooth' }));
  }

  function initGalleryBg() {
    const slides = document.querySelectorAll('.gallery-bg-slide');
    if (slides.length <= 1) return;
    let current = 0;
    setInterval(() => {
      slides[current].classList.remove('is-active');
      current = (current + 1) % slides.length;
      slides[current].classList.add('is-active');
    }, 6000);
  }

  function initPhotoshootGallery() {
    const dataEl = document.getElementById('photoshoot-data');
    if (!dataEl) return;
    const shoots = JSON.parse(dataEl.textContent || '[]');
    const lightbox = document.getElementById('photoshoot-lightbox');
    const img = document.getElementById('lightbox-image');
    const caption = document.getElementById('lightbox-caption');
    const thumbsWrap = document.getElementById('lightbox-thumbs');
    if (!lightbox || !img || !caption || !thumbsWrap) return;

    let currentShoot = null;
    let currentIndex = 0;

    function render() {
      img.src = currentShoot.photos[currentIndex];
      img.alt = currentShoot.name;
      caption.textContent = `${currentShoot.name} — by ${currentShoot.photographer}`;
      thumbsWrap.innerHTML = '';
      currentShoot.photos.forEach((src, i) => {
        const t = document.createElement('img');
        t.src = src;
        t.className =
          'w-16 h-16 object-cover rounded cursor-pointer border-2 flex-shrink-0 ' +
          (i === currentIndex ? 'border-accent-gold' : 'border-transparent opacity-70');
        t.addEventListener('click', () => {
          currentIndex = i;
          render();
        });
        thumbsWrap.appendChild(t);
      });
    }

    function open(id) {
      currentShoot = shoots.find(s => s.id === id);
      if (!currentShoot) return;
      currentIndex = 0;
      render();
      lightbox.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }
    function close() {
      lightbox.classList.add('hidden');
      document.body.style.overflow = '';
    }
    function next() {
      currentIndex = (currentIndex + 1) % currentShoot.photos.length;
      render();
    }
    function prev() {
      currentIndex = (currentIndex - 1 + currentShoot.photos.length) % currentShoot.photos.length;
      render();
    }

    document.querySelectorAll('.photoshoot-card').forEach(card => {
      card.addEventListener('click', () => open(card.getAttribute('data-shoot')));
    });
    document.getElementById('lightbox-close')?.addEventListener('click', close);
    document.getElementById('lightbox-next')?.addEventListener('click', next);
    document.getElementById('lightbox-prev')?.addEventListener('click', prev);
    lightbox.addEventListener('click', e => {
      if (e.target === lightbox) close();
    });
    document.addEventListener('keydown', e => {
      if (lightbox.classList.contains('hidden')) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowRight') next();
      if (e.key === 'ArrowLeft') prev();
    });
  }

  document.addEventListener('astro:page-load', () => {
    initHeroCarousel();
    initMusicCarousel();
    initGalleryBg();
    initPhotoshootGallery();
  });
  initHeroCarousel();
  initMusicCarousel();
  initGalleryBg();
  initPhotoshootGallery();
</script>
