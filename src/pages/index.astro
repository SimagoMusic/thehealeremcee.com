    <div class="absolute inset-0 bg-black/60"></div>
    <div class="relative z-10 text-center px-6 max-w-2xl">
      <h2 class="font-heading font-light text-text-heading uppercase tracking-[0.35em]" style="font-size: clamp(1.5rem, 4vw, 2.5rem);">
        Video
      </h2> <!-- EDIT: video heading -->
      <p class="font-body font-light text-text-primary mt-6 leading-relaxed">
        Live performance. Music videos. Sound healing. Behind the scenes.
      </p> <!-- EDIT: video intro -->
      <a href="/video" class="inline-block mt-8 font-heading text-accent-gold uppercase text-sm tracking-[0.15em] hover:text-accent-gold-hover transition-colors" data-sound="chime">
        Watch &rarr;
      </a> <!-- EDIT: video link text -->
    </div>
  </section>

  <!-- Section 5: Theatre -->
  <!-- EDIT: THEATRE -->
  <section class="bg-bg-primary py-24 md:py-32" data-section="theatre">
    <div class="max-w-5xl mx-auto px-6">
      <h2 class="font-heading font-light text-text-heading uppercase tracking-[0.35em] text-center" style="font-size: clamp(1.5rem, 4vw, 2.5rem);">
        Theatre
      </h2> <!-- EDIT: theatre heading -->
      <p class="font-body font-light text-text-primary mt-6 text-center max-w-2xl mx-auto leading-relaxed">
        Original works directed for the stage.<br />
        Theater rooted in community, cultural identity, and lived experience.
      </p> <!-- EDIT: theatre intro -->

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mt-14">
        <a href="/theatre" class="group block">
          <div class="aspect-[3/4] overflow-hidden rounded-lg">
            <img src="/images/theatre/stars-belong.webp" alt="The Stars Belong to All of Us" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" /> <!-- EDIT: theatre work 1 image -->
          </div>
          <p class="font-heading text-text-heading uppercase text-xs tracking-[0.15em] mt-3">The Stars Belong to All of Us</p> <!-- EDIT: theatre work 1 title -->
        </a>
        <a href="/theatre" class="group block">
          <div class="aspect-[3/4] overflow-hidden rounded-lg">
            <img src="/images/theatre/florecer.jpeg" alt="Florecer — To Bloom" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" /> <!-- EDIT: theatre work 2 image -->
          </div>
          <p class="font-heading text-text-heading uppercase text-xs tracking-[0.15em] mt-3">Florecer — To Bloom</p> <!-- EDIT: theatre work 2 title -->
        </a>
        <a href="/theatre" class="group block">
          <div class="aspect-[3/4] overflow-hidden rounded-lg">
            <img src="/images/theatre/achievement-gap.webp" alt="Caught in the Achievement Gap" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" /> <!-- EDIT: theatre work 3 image -->
          </div>
          <p class="font-heading text-text-heading uppercase text-xs tracking-[0.15em] mt-3">Caught in the Achievement Gap</p> <!-- EDIT: theatre work 3 title -->
        </a>
      </div>

      <div class="text-center mt-12">
        <a href="/theatre" class="font-heading text-accent-gold uppercase text-sm tracking-[0.15em] hover:text-accent-gold-hover transition-colors" data-sound="chime">
          View directed works &rarr;
        </a> <!-- EDIT: theatre link text -->
      </div>
    </div>
  </section>

  <!-- Section 6: About (image left, text right) -->
  <!-- EDIT: ABOUT -->
  <section class="bg-bg-deep py-24 md:py-32" data-section="about">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="aspect-[3/4] overflow-hidden rounded-lg">
          <img src="/images/IMG_2003.jpg" alt="Simago portrait" class="w-full h-full object-cover" loading="lazy" /> <!-- EDIT: about portrait image -->
        </div>
        <div>
          <h2 class="font-heading font-light text-text-heading uppercase tracking-[0.35em]" style="font-size: clamp(1.5rem, 4vw, 2.5rem);">
            About
          </h2> <!-- EDIT: about heading -->
          <p class="font-body font-light text-text-primary mt-6 leading-relaxed">
            Sierra "Simago" Gonzalez is a Puerto Rican Cuban artist —
            Chicago born, California raised, first-generation American.
            Musician, playwright, sound healer, educator, poet.
          </p> <!-- EDIT: about bio -->
          <a href="/about" class="inline-block mt-8 font-heading text-accent-gold uppercase text-sm tracking-[0.15em] hover:text-accent-gold-hover transition-colors" data-sound="chime">
            Read more &rarr;
          </a> <!-- EDIT: about link text -->
        </div>
      </div>
    </div>
  </section>

  <!-- Section 7: Hire (text left, image right) -->
  <!-- EDIT: HIRE -->
  <section class="bg-bg-primary py-24 md:py-32" data-section="hire">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="order-2 md:order-1">
          <h2 class="font-heading font-light text-text-heading uppercase tracking-[0.35em]" style="font-size: clamp(1.5rem, 4vw, 2.5rem);">
            Hire
          </h2> <!-- EDIT: hire heading -->
          <p class="font-body font-light text-text-primary mt-6 leading-relaxed">
            Available for performances, commissions, sound healing sessions,
            directing, workshops, and curriculum development.
            Bilingual (English/Spanish).
          </p> <!-- EDIT: hire description -->
          <a href="/hire" class="inline-block mt-8 font-heading text-accent-gold uppercase text-sm tracking-[0.15em] hover:text-accent-gold-hover transition-colors" data-sound="chime">
            Work with me &rarr;
          </a> <!-- EDIT: hire link text -->
        </div>
        <div class="order-1 md:order-2 aspect-[3/4] overflow-hidden rounded-lg">
          <img src="/images/IMG_7058.jpg" alt="Simago among flowers and greenery" class="w-full h-full object-cover" loading="lazy" /> <!-- EDIT: hire image -->
        </div>
      </div>
    </div>
  </section>

  <!-- Section 8: Contact (footer with background image) -->
  <!-- EDIT: CONTACT -->
  <section
    class="relative py-24 md:py-32 bg-cover bg-center"
    style="background-image: url('/images/IMG_1998_wide.jpg');"
    data-section="contact"
  >
    <div class="absolute inset-0 bg-black/65"></div>
    <div class="relative z-10 max-w-2xl mx-auto text-center px-6">
      <h2 class="font-heading font-light text-text-heading uppercase tracking-[0.35em]" style="font-size: clamp(1.5rem, 4vw, 2.5rem);">
        Contact
      </h2> <!-- EDIT: contact heading -->
      <p class="font-body font-light text-text-primary mt-6 leading-relaxed">
        For bookings, collaborations, press inquiries, or just to say hello.
      </p> <!-- EDIT: contact intro -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mt-10">
        <a href="mailto:simagomusic@gmail.com" class="btn-gold px-8 py-3 bg-accent-gold text-bg-deep uppercase text-sm tracking-[0.15em] font-heading hover:bg-accent-gold-hover transition-colors">Email</a> <!-- EDIT: contact email address -->
        <a href="/contact" class="px-8 py-3 border border-accent-gold text-text-heading uppercase text-sm tracking-[0.15em] font-heading hover:bg-accent-gold hover:text-bg-deep transition-all" data-sound="chime">Contact Form</a> <!-- EDIT: contact form button text -->
      </div>
      <div class="mt-16 space-y-2">
        <p class="text-text-muted text-sm tracking-[0.1em]">Oakland, CA</p> <!-- EDIT: location line -->
        <a href="https://instagram.com/simago" target="_blank" rel="noopener noreferrer" class="text-text-muted text-sm tracking-[0.1em] hover:text-accent-gold transition-colors inline-block">@simago</a> <!-- EDIT: instagram handle -->
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* Hero carousel: each slide is stacked directly on top of the others.
     Only the slide with .is-active showing has opacity 1; everything else is invisible.
     The script below moves the .is-active class to the next slide on a timer,
     and the CSS transition makes that swap fade smoothly instead of snapping. */
  .hero-slide {
    opacity: 0;
    transition: opacity 1.5s ease-in-out;
    /* Anchors the visible crop toward the top of each photo so faces
       stay in frame, instead of cropping around the exact center. */
    object-position: center 15%;
  }
  .hero-slide.is-active {
    opacity: 1;
  }

  .gallery-scroll-container {
    width: 100%;
    overflow: hidden;
  }
  .gallery-scroll-track {
    display: flex;
    gap: 1rem;
    animation: gallery-scroll 60s linear infinite;
    width: max-content;
  }
  .gallery-slide {
    flex-shrink: 0;
    width: 300px;
    height: 400px;
    border-radius: 0.5rem;
    overflow: hidden;
  }
  @keyframes gallery-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  .gallery-scroll-container:hover .gallery-scroll-track {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .gallery-scroll-track {
      animation: none;
      overflow-x: auto;
    }
  }
</style>

<script>
  // Rotates the hero background through each .hero-slide image, fading
  // smoothly between them. Runs once per page load.
  function initHeroCarousel() {
    const container = document.getElementById('hero-carousel');
    if (!container) return;

    const slides = container.querySelectorAll('.hero-slide');
    if (slides.length <= 1) return; // nothing to rotate between

    let current = 0;
    const HOLD_TIME_MS = 5000; // how long each photo stays fully visible before fading to the next

    setInterval(() => {
      slides[current].classList.remove('is-active');
      current = (current + 1) % slides.length;
      slides[current].classList.add('is-active');
    }, HOLD_TIME_MS);
  }

  document.addEventListener('astro:page-load', initHeroCarousel);
  initHeroCarousel();
</script>
