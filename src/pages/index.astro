---
import BaseLayout from '../layouts/BaseLayout.astro';

const galleryImages = [
  { src: '/images/gallery/gold-fabric.jpg', alt: 'Simago wrapped in gold patterned fabric' },
  { src: '/images/IMG_2003.jpg', alt: 'Simago portrait with red lips' },
  { src: '/images/gallery/red-seat-leaning.jpg', alt: 'Simago leaning in red chair' },
  { src: '/images/IMG_7058.jpg', alt: 'Simago among flowers' },
  { src: '/images/gallery/red-rose.jpg', alt: 'Simago with rose and Puerto Rican flag' },
  { src: '/images/gallery/singing-bowls-live.jpg', alt: 'Simago performing with singing bowls' },
  { src: '/images/gallery/red-seat-looking.jpg', alt: 'Simago looking at camera in red chair' },
  { src: '/images/IMG_7055.jpg', alt: 'Simago seated near statue in garden' },
  { src: '/images/gallery/cactus-mirror.jpg', alt: 'Simago reflection in glass with cactus' },
  { src: '/images/gallery/red-seat-standing.jpg', alt: 'Simago standing in gold textile' },
  { src: '/images/about-portrait.jpg', alt: 'Simago portrait with headwrap and palm tree' },
  { src: '/images/gallery/sound-bath-ceremony.jpg', alt: 'Sound bath ceremony with singing bowls' },
];
---

<BaseLayout title="Simago — The Healer Emcee">

  <!-- Section 1: Hero -->
  <!-- EDIT: HERO -->
  <section class="relative min-h-screen flex items-center justify-center bg-bg-primary overflow-hidden" data-section="hero">
    <img src="/images/New Photos/IMG_5318.jpeg" alt="Simago standing by a lake among tall reeds" class="absolute inset-0 w-full h-full object-cover" /> <!-- EDIT: hero background image -->
    <div class="relative z-10 text-center px-6">
      <div class="inline-block px-8 py-6">
        <h1 class="font-heading font-light text-text-heading uppercase mt-16" style="font-size: clamp(2.5rem, 8vw, 5rem); letter-spacing: 0.35em; text-shadow: 0 2px 20px rgba(0,0,0,0.5);">
          SIMAGO
        </h1> <!-- EDIT: hero name -->
        <p class="font-heading font-light text-text-heading uppercase tracking-[0.25em] mt-4" style="font-size: clamp(1rem, 2.5vw, 1.5rem); text-shadow: 0 2px 16px rgba(0,0,0,0.5);">
          The Healer Emcee
        </p> <!-- EDIT: hero tagline -->
        <p class="font-body font-light text-text-primary mt-6 max-w-[500px] mx-auto text-center leading-relaxed" style="font-size: clamp(0.95rem, 1.5vw, 1.1rem); text-shadow: 0 1px 12px rgba(0,0,0,0.4);">Hip-Hop. Sound Healer. Storyteller. Mystic of God.</p> <!-- EDIT: hero subtitle -->
      </div>
    </div>
  </section>

  <!-- Section 2: Music -->
  <!-- EDIT: MUSIC -->
  <section class="relative py-24 md:py-32 overflow-hidden" data-section="music">
    <video
      autoplay
      muted
      loop
      playsinline
      class="absolute inset-0 w-full h-full object-cover"
      aria-hidden="true"
    >
      <source src="/video/music-bg-loop.mp4" type="video/mp4" /> <!-- EDIT: music background video -->
    </video>
    <div class="absolute inset-0 bg-black/70"></div>
    <div class="relative z-10 max-w-5xl mx-auto px-6">
      <h2 class="font-heading font-light text-text-heading uppercase tracking-[0.35em] text-center" style="font-size: clamp(1.5rem, 4vw, 2.5rem);">
        Music
      </h2> <!-- EDIT: music heading -->
      <p class="font-body font-light text-text-primary mt-6 text-center max-w-2xl mx-auto leading-relaxed">
        Healer-hop.
      </p> <!-- EDIT: music intro -->

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mt-14">
        <a href="/music" class="group block">
          <div class="aspect-square overflow-hidden rounded-lg border border-white/[0.08] group-hover:border-accent-gold/30 transition-colors">
            <img src="/images/red-seat/S8z.jpg" alt="Sound of Soul" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" /> <!-- EDIT: album 1 cover image -->
          </div>
          <p class="font-heading text-text-heading uppercase text-xs tracking-[0.2em] mt-3">Sound of Soul</p> <!-- EDIT: album 1 title -->
          <p class="text-text-muted text-xs mt-1">2026</p> <!-- EDIT: album 1 year -->
        </a>
        <a href="/music" class="group block">
          <div class="aspect-square overflow-hidden rounded-lg border border-white/[0.08] group-hover:border-accent-gold/30 transition-colors">
            <img src="/images/red-seat/S5z.jpg" alt="Simago & The Healers" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" /> <!-- EDIT: album 2 cover image -->
          </div>
          <p class="font-heading text-text-heading uppercase text-xs tracking-[0.2em] mt-3">Simago & The Healers</p> <!-- EDIT: album 2 title -->
          <p class="text-text-muted text-xs mt-1">2025</p> <!-- EDIT: album 2 year -->
        </a>
        <a href="/music" class="group block">
          <div class="aspect-square overflow-hidden rounded-lg border border-white/[0.08] group-hover:border-accent-gold/30 transition-colors">
            <img src="/images/IMG_1960.jpg" alt="I Am the Moon" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" /> <!-- EDIT: album 3 cover image -->
          </div>
          <p class="font-heading text-text-heading uppercase text-xs tracking-[0.2em] mt-3">I Am the Moon</p> <!-- EDIT: album 3 title -->
          <p class="text-text-muted text-xs mt-1">2022</p> <!-- EDIT: album 3 year -->
        </a>
      </div>

      <div class="text-center mt-12">
        <a href="/music" class="font-heading text-accent-gold uppercase text-sm tracking-[0.15em] hover:text-accent-gold-hover transition-colors" data-sound="chime">
          Explore the full catalogue &rarr;
        </a> <!-- EDIT: music link text -->
      </div>
    </div>
  </section>

  <!-- Section 3: Gallery (auto-scrolling) -->
  <!-- EDIT: GALLERY -->
  <section class="bg-bg-deep py-24 md:py-32 overflow-hidden" data-section="gallery">
    <div class="max-w-5xl mx-auto px-6 mb-12">
      <h2 class="font-heading font-light text-text-heading uppercase tracking-[0.35em] text-center" style="font-size: clamp(1.5rem, 4vw, 2.5rem);">
        Gallery
      </h2> <!-- EDIT: gallery heading -->
    </div>
    <div class="gallery-scroll-container">
      <div class="gallery-scroll-track">
        {galleryImages.map(img => (
          <div class="gallery-slide">
            <img src={img.src} alt={img.alt} loading="lazy" class="w-full h-full object-cover" />
          </div>
        ))}
        {/* Duplicate for seamless loop */}
        {galleryImages.map(img => (
          <div class="gallery-slide" aria-hidden="true">
            <img src={img.src} alt="" loading="lazy" class="w-full h-full object-cover" />
          </div>
        ))}
      </div>
    </div>
    <div class="text-center mt-12">
      <a href="/gallery" class="font-heading text-accent-gold uppercase text-sm tracking-[0.15em] hover:text-accent-gold-hover transition-colors" data-sound="chime">
        View full gallery &rarr;
      </a> <!-- EDIT: gallery link text -->
    </div>
  </section>

  <!-- Section 4: Video -->
  <!-- EDIT: VIDEO -->
  <section class="relative min-h-[70vh] flex items-center justify-center overflow-hidden" data-section="video">
    <video
      autoplay
      muted
      loop
      playsinline
      class="absolute inset-0 w-full h-full object-cover"
      aria-hidden="true"
    >
      <source src="/video/homepage-see-loop.mp4" type="video/mp4" /> <!-- EDIT: video background loop -->
