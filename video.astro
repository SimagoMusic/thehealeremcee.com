---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Video — Simago" description="Live performance, music videos, sound healing, and behind the scenes.">
  <!-- Header -->
  <!-- EDIT: HERO -->
  <section class="relative min-h-[60vh] flex items-center justify-center bg-bg-deep">
    <div class="text-center px-6">
      <h1 class="font-heading font-light text-text-heading uppercase tracking-[0.35em]" style="font-size: clamp(1.5rem, 4vw, 2.5rem);">Video</h1> <!-- EDIT: hero heading -->
      <p class="font-heading font-light text-text-muted uppercase tracking-[0.15em] mt-6 text-xs sm:text-sm max-w-lg mx-auto">Live performance. Music videos. Sound healing. Behind the scenes.</p> <!-- EDIT: hero tagline -->
    </div>
  </section>

  <!-- Coming Soon Section -->
  <!-- EDIT: COMING SOON -->
  <section class="bg-bg-primary py-24 md:py-32 min-h-[40vh] flex items-center" data-section="video-coming-soon">
    <div class="max-w-2xl mx-auto px-6 text-center">
      <p class="font-body font-light text-text-primary text-lg leading-relaxed">Video content is on the way.</p> <!-- EDIT: coming soon heading -->
      <p class="font-body font-light text-text-muted mt-6 leading-relaxed">Live recordings, press appearances, and behind-the-scenes from the studio and the stage. Check back soon.</p> <!-- EDIT: coming soon paragraph -->
      <a href="https://instagram.com/simago" target="_blank" rel="noopener noreferrer" class="inline-block mt-10 font-heading text-accent-gold uppercase text-sm tracking-[0.15em] hover:text-accent-gold-hover transition-colors" data-sound="chime">Follow @simago on Instagram &rarr;</a> <!-- EDIT: instagram link text -->
    </div>
  </section>
</BaseLayout>
